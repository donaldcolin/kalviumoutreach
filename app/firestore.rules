rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ──────────────────────────────────────────────────────
    // Is the caller an admin?
    function isAdmin() {
      return request.auth.token.role == 'admin';
    }

    // Is the caller a non-executive (admin, teamLead, seniorManager, or regionalManager)?
    function isManager() {
      return request.auth.token.role in ['admin', 'regionalManager', 'seniorManager', 'teamLead'];
    }

    // Can the caller see data belonging to targetUserId?
    function canSeeUser(targetUserId) {
      return request.auth.uid == targetUserId
          || isAdmin()
          || (request.auth.token.role == 'teamLead' && request.auth.token.managerId == request.auth.uid) // Note: Custom Claims don't know the TARGET's managerId directly without a get()
          // For now, we will allow managers to read if they are managers, but ideally we'd pass managerId on the doc.
          || isManager(); 
    }

    // ─── Users ─────────────────────────────────────────────────────────────────
    // Executives can only read their own profile.
    // Managers/admins can read all profiles (needed to build team sidebar).
    match /users/{userId} {
      allow read: if request.auth != null
                  && (request.auth.uid == userId || isManager());
      // Users can only update their own lastKnownLocation (prevent role escalation)
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'lastKnownLocation',
                      'lastKnownLocation.lat',
                      'lastKnownLocation.lng',
                      'lastKnownLocation.ts',
                      'lastKnownLocation.updatedAt',
                      'fcmToken'
                    ]);
      // Only managers can create new user profiles
      allow create: if request.auth != null
                    && isManager();
      allow delete: if false; // Only manageable from server/admin SDK
    }

    // ─── Daily Tracks (GPS) ────────────────────────────────────────────────────
    // GPS location data — the most sensitive collection.
    // Executives can only read/write their own tracks.
    // Managers can read tracks of their direct reports.
    // Admins can read all.
    match /dailyTracks/{trackId} {
      allow read: if request.auth != null
                  && canSeeUser(trackId.split('_')[0]);
      // Write: own tracks, or non-executive managers
      allow write: if request.auth != null
                   && (trackId.split('_')[0] == request.auth.uid || isManager());

      match /locations/{locationId} {
        allow read: if request.auth != null
                    && canSeeUser(trackId.split('_')[0]);
        allow write: if request.auth != null
                     && trackId.split('_')[0] == request.auth.uid;
      }
      match /visits/{visitId} {
        allow read: if request.auth != null
                    && canSeeUser(trackId.split('_')[0]);
        allow write: if request.auth != null
                     && trackId.split('_')[0] == request.auth.uid;
      }
    }

    // ─── Visits (top-level) ────────────────────────────────────────────────────
    match /visits/{visitId} {
      allow read: if request.auth != null
                  && (resource.data.executiveId == request.auth.uid || isManager());
      allow write: if request.auth != null
                   && resource.data.executiveId == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.executiveId == request.auth.uid;
    }

    // ─── Meetings ──────────────────────────────────────────────────────────────
    match /meetings/{meetingId} {
      allow read: if request.auth != null
                  && (resource.data.executiveId == request.auth.uid || isManager());
      allow write: if request.auth != null
                   && resource.data.executiveId == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.executiveId == request.auth.uid;
    }

    // ─── Appointments / Tasks ──────────────────────────────────────────────────
    match /appointments/{appId} {
      allow read: if request.auth != null
                  && (resource.data.executiveId == request.auth.uid || isManager());
      // Associate can update their own tasks (e.g. mark complete)
      allow update: if request.auth != null
                    && resource.data.executiveId == request.auth.uid;
      // TLs/Admins can manage tasks (create, update, delete)
      allow write: if request.auth != null && isManager();
    }

    // ─── Schools ───────────────────────────────────────────────────────────────
    // Schools are reference data, readable by any authenticated user.
    match /schools/{schoolId} {
      allow read: if request.auth != null;
      allow write: if false; // Only admin SDK
    }

    // ─── Location Requests ─────────────────────────────────────────────────────
    // Scoped: executives see only their own, managers see all.
    match /locationRequests/{reqId} {
      allow read: if request.auth != null
                  && (resource.data.targetUserId == request.auth.uid || isManager());
      allow create: if request.auth != null && isManager();
      allow update: if request.auth != null;
    }

    // ─── CRM Activities ────────────────────────────────────────────────────────
    // Executives can only read/write their own activities.
    // Managers can read their team's activities.
    match /crmActivities/{activityId} {
      allow read: if request.auth != null
                  && (resource.data.executiveId == request.auth.uid || isManager());
      allow write: if request.auth != null
                   && (resource == null || resource.data.executiveId == request.auth.uid)
                   && (request.resource == null || request.resource.data.executiveId == request.auth.uid);
    }

    // ─── Push Queue ────────────────────────────────────────────────────────────
    match /pushQueue/{docId} {
      allow read: if request.auth != null
                  && (resource.data.executiveId == request.auth.uid || isManager());
      allow write: if request.auth != null
                   && (resource == null || resource.data.executiveId == request.auth.uid)
                   && (request.resource == null || request.resource.data.executiveId == request.auth.uid);
    }

    // ─── Meeting Recordings ────────────────────────────────────────────────────
    match /meetingRecordings/{recordingId} {
      allow read: if request.auth != null
                  && (resource.data.executiveId == request.auth.uid || isManager());
      allow write: if request.auth != null
                   && resource.data.executiveId == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.executiveId == request.auth.uid;
    }

    // ─── Ongoing Walk-Ins ──────────────────────────────────────────────────────
    match /ongoingWalkIns/{wUserId} {
      allow read: if request.auth != null
                  && (request.auth.uid == wUserId || isManager());
      allow write: if request.auth != null && request.auth.uid == wUserId;
      allow delete: if request.auth != null && request.auth.uid == wUserId;
    }

    // ─── System Logs ───────────────────────────────────────────────────────────
    // Write-only from mobile app. Only non-executives can read.
    match /system_logs/{logId} {
      allow read: if request.auth != null && isManager();
      allow create: if request.auth != null
                    && request.resource.data.associateId == request.auth.uid;
      allow update, delete: if false; // Logs are immutable
    }

    // ─── Lead Access Requests ──────────────────────────────────────────────────
    match /leadAccessRequests/{reqId} {
      // Users can read their own requests; managers can read all
      allow read: if request.auth != null
                  && (resource.data.requestedBy == request.auth.uid || isManager());
      allow create: if request.auth != null
                    && request.resource.data.requestedBy == request.auth.uid;
      // Only managers can approve (update status)
      allow update: if request.auth != null && isManager();
      allow delete: if false;
    }
  }
}
