{
  "name": "kalvium-outreach",
  "private": true,
  "workspaces": [
    "packages/*",
    "app",
    "website",
    "webhook-server"
  ],
  "scripts": {
    "build:shared": "npm run build -w packages/shared",
    "dev:website": "npm run dev -w website",
    "dev:app": "npm run start -w app",
    "typecheck": "npm run build:shared && cd app && npx tsc --noEmit && cd ../website && npx tsc -b"
  },
  "version": "1.0.0",
  "dependencies": {
    "baseline-browser-mapping": "^2.11.10",
    "browserslist": "^4.28.7",
    "caniuse-lite": "^1.0.30001806",
    "expo": "^56.0.17",
    "lightningcss": "^1.30.1",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-css": "3.0.6"
  },
  "devDependencies": {
    "dlv": "^1.1.3",
    "object-hash": "^3.0.0"
  },
  "overrides": {
    "jest-expo": {
      "@react-native/jest-preset": "$@react-native/jest-preset"
    },
    "@legendapp/motion": {
      "nativewind": "$nativewind"
    },
    "react-test-renderer": {
      "react": "$react"
    },
    "react-dom": {
      "react": "$react"
    }
  }
}
